{
  "name": "dsh-openspec-suite",
  "version": "0.1.0",
  "description": "DSH plugin: OpenSpec project management (folder scan, workspace import, proposal progress overview as a left-sidebar second-level page).",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "schemastery": "^3.18.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  }
}